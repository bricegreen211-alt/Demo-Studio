    "chokidar": "^3.6.0",
    "events": "^3.3.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "png-to-ico": "2.1.8",
