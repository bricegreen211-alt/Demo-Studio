{
  "name": "cognigy-demo-studio",
  "version": "1.2.0",
  "private": true,
  "description": "Cognigy Demo Studio \u2014 local companion app + browser extension for SE demo experiences",
  "main": "apps/studio/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node assets/postinstall.js",
    "setup": "node assets/make-launcher.js",
    "mcp:register": "node assets/register-mcp.js",
    "service": "node apps/studio/service/standalone.js",
    "build:audio": "node assets/build-audio-clean.js",
